/* ── READER ── */
function openReader(id) {
  const b = books.find(b => b.id === id);
  if (!b) return;
  currentBookId = id;

  // Set title
  document.getElementById('reader-title').textContent = b.title + (b.author ? ' — ' + b.author : '');

  const isDrive = b.driveUrl && b.driveUrl.trim();

  // Show/hide appropriate panels
  const textContent = document.getElementById('reader-content');
  const driveArea = document.getElementById('reader-drive-area');
  const footer = document.getElementById('reader-footer');
  const fontCtrl = document.getElementById('font-size-ctrl');
  const finishBanner = document.getElementById('finish-banner');
  const themBtn = document.getElementById('reader-theme-btn');

  if (isDrive) {
    // Drive mode
    textContent.style.display = 'none';
    driveArea.style.display = 'flex';
    footer.style.display = 'none';
    fontCtrl.style.display = 'none';
    themBtn.style.display = 'none';

    const embedUrl = driveUrlToEmbed(b.driveUrl);
    const driveMsg = document.getElementById('reader-drive-msg');
    const driveFrame = document.getElementById('reader-drive-frame');
    const openLink = document.getElementById('drive-open-link');
    document.getElementById('drive-book-title').textContent = b.title;
    openLink.href = b.driveUrl;

    // Try to embed
    driveMsg.style.display = 'flex';
    driveFrame.style.display = 'none';
    driveFrame.src = '';
    // Attempt iframe load
    driveFrame.onload = function() {
      try {
        // Show iframe once loaded
        driveFrame.style.display = 'block';
        driveMsg.style.display = 'none';
      } catch(e) {}
    };
    driveFrame.onerror = function() {
      driveFrame.style.display = 'none';
      driveMsg.style.display = 'flex';
    };
    setTimeout(() => {
      driveFrame.src = embedUrl;
      // Show frame after short delay; keep msg visible until it loads
      setTimeout(() => {
        driveFrame.style.display = 'block';
        driveMsg.style.display = 'none';
      }, 1800);
    }, 100);

    // Show finish banner always for drive books (user confirms manually)
    const timesRead = b.timesRead || 0;
    document.getElementById('finish-banner-sub').textContent =
      timesRead > 0 ? `Ya lo leíste ${timesRead} ${timesRead === 1 ? 'vez' : 'veces'}` : 'Primera vez que lo lees';
    finishBanner.classList.add('visible');

  } else {
    // Text mode
    textContent.style.display = '';
    driveArea.style.display = 'none';
    footer.style.display = '';
    fontCtrl.style.display = '';
    themBtn.style.display = '';

    const paragraphs = b.content.split('\n').filter(p => p.trim());
    const paper = document.getElementById('reader-paper');
    paper.innerHTML = `<div class="reader-chapter-title">${b.emoji || '📖'} ${b.title}</div>` + paragraphs.map(p => `<p>${p}</p>`).join('');
    paper.style.fontSize = currentFontSize + 'px';
    const savedScroll = b.scrollTop || 0;
    setTimeout(() => { textContent.scrollTop = savedScroll; updateReadingProgress(); }, 50);

    // Show finish banner when near end
    updateFinishBanner(b);
  }

  document.getElementById('reader-view').classList.add('open');
  if (b.status === 'unread') { b.status = 'reading'; save(); renderAll(); }
}

function updateFinishBanner(b) {
  const finishBanner = document.getElementById('finish-banner');
  // For text books: show when progress >= 85%
  if (!b) { finishBanner.classList.remove('visible'); return; }
  if (b.driveUrl) return; // handled in openReader for drive books
  const pct = b.progress || 0;
  const timesRead = b.timesRead || 0;
  if (pct >= 85) {
    document.getElementById('finish-banner-sub').textContent =
      timesRead > 0 ? `Ya lo leíste ${timesRead} ${timesRead === 1 ? 'vez' : 'veces'} — ¿otra ronda?` : 'Primera vez que lo completas';
    finishBanner.classList.add('visible');
  } else {
    finishBanner.classList.remove('visible');
  }
}

function confirmFinished() {
  if (!currentBookId) return;
  const b = books.find(b => b.id === currentBookId);
  if (!b) return;
  b.status = 'finished';
  b.progress = 100;
  b.timesRead = (b.timesRead || 0) + 1;
  save(); renderAll();
  const times = b.timesRead;
  const msg = times === 1 ? '¡Primer libro completado! 🎉' : `¡Leído ${times} veces! 🏆`;
  showToast(`${msg} "${b.title}" marcado como terminado`);
  // Update banner text
  document.getElementById('finish-banner-sub').textContent = `Leído ${times} ${times === 1 ? 'vez' : 'veces'} en total — ¡felicidades!`;
}

function closeReader() {
  document.getElementById('reader-view').classList.remove('open');
  // Clear drive frame src to stop loading
  document.getElementById('reader-drive-frame').src = '';
  currentBookId = null;
}

function updateReadingProgress() {
  const content = document.getElementById('reader-content');
  const { scrollTop, scrollHeight, clientHeight } = content;
  const max = scrollHeight - clientHeight;
  const pct = max > 0 ? Math.round((scrollTop / max) * 100) : 0;
  document.getElementById('reader-progress-fill').style.width = pct + '%';
  document.getElementById('reader-page-info').textContent = pct + '%';
  const wpm = 200;
  const words = document.getElementById('reader-paper').textContent.split(/\s+/).length;
  const remaining = Math.max(0, Math.round(words * (1 - pct/100) / wpm));
  document.getElementById('reader-time-left').textContent = remaining > 0 ? `~${remaining} min restantes` : '¡Terminado!';
  if (currentBookId) {
    const b = books.find(b => b.id === currentBookId);
    if (b) {
      b.progress = pct; b.scrollTop = scrollTop;
      if (pct >= 95 && b.status !== 'finished') b.status = 'reading'; // don't auto-finish, let user confirm
      save();
      updateFinishBanner(b);
    }
  }
}

