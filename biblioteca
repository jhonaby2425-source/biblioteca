<div id="toast"></div>

<script>
const COLORS = [
  '#8B2252','#C45C26','#B8860B','#2E6F40','#1B5E7A','#3D3585','#7B3F6E','#4A3728',
  '#D4546A','#E87D3E','#E8B84B','#4CAF7A','#3A9CC1','#6B5BC4','#B05D9E','#8D6E63',
  '#FF6B9D','#FF9F6B','#FFD166','#06D6A0','#4CC9F0','#7C4DFF','#F72585','#8338EC'
];
const EMOJIS = ['📖','📚','✨','🌟','🦋','🌹','🗡️','🏰','🌊','🌙','⚡','🔮','🌺','🎭','🦅','🐺','🍂','❄️','🔥','💎','🎪','🌌','🏔️','🎯'];

let books = JSON.parse(localStorage.getItem('biblioteca_books') || '[]');
let currentFilter = 'all';
let currentFontSize = 18;
let editingId = null;
let selectedColor = COLORS[0];
let selectedEmoji = EMOJIS[0];
let readerNight = false;
let currentBookId = null;
let activeContentTab = 'text';

/* ── COVER IMAGE PREVIEW ── */
function onCoverUrlChange() {
  const url = document.getElementById('f-cover-url').value.trim();
  updateCoverPreview(url);
}

function updateCoverPreview(url, emoji) {
  const thumb = document.getElementById('cover-preview-thumb');
  if (url) {
    thumb.innerHTML = `<img src="${url}" onerror="this.parentElement.innerHTML='❌'" alt="portada">`;
  } else {
    thumb.innerHTML = emoji || selectedEmoji || '📖';
  }
}

async function fetchCoverAuto() {
  const title = document.getElementById('f-title').value.trim();
  const author = document.getElementById('f-author').value.trim();
  if (!title) { showToast('Ingresa el título para buscar la portada'); return; }
  const status = document.getElementById('fetch-cover-status');
  status.textContent = '🔍 Buscando portada...';
  const query = encodeURIComponent((title + ' ' + author).trim());
  try {
    const res = await fetch(`https://www.googleapis.com/books/v1/volumes?q=${query}&maxResults=3`);
    const data = await res.json();
    if (data.items && data.items.length > 0) {
      // Try to find item with image
      let imgUrl = null;
      for (const item of data.items) {
        const img = item.volumeInfo && item.volumeInfo.imageLinks;
        if (img) {
          imgUrl = img.extraLarge || img.large || img.medium || img.thumbnail;
          if (imgUrl) { imgUrl = imgUrl.replace('http://', 'https://'); break; }
        }
      }
      if (imgUrl) {
        document.getElementById('f-cover-url').value = imgUrl;
        updateCoverPreview(imgUrl);
        status.textContent = '✅ Portada encontrada';
      } else {
        status.textContent = '⚠️ No se encontró imagen — prueba con una URL manual';
      }
    } else {
      status.textContent = '⚠️ No se encontraron resultados';
    }
  } catch(e) {
    status.textContent = '❌ Error de red al buscar la portada';
  }
}

/* ── CONTENT TABS ── */
function switchContentTab(tab) {
  activeContentTab = tab;
  document.getElementById('tab-text').classList.toggle('active', tab === 'text');
  document.getElementById('tab-drive').classList.toggle('active', tab === 'drive');
  document.getElementById('content-text-section').style.display = tab === 'text' ? '' : 'none';
  const driveSection = document.getElementById('content-drive-section');
  driveSection.classList.toggle('active', tab === 'drive');
  driveSection.style.display = tab === 'drive' ? 'block' : 'none';
}

/* ── INIT ── */
function init() {
  if (books.length === 0) seedSampleBooks();
  buildColorPicker();
  buildEmojiPicker();
  renderAll();
  updateDrivePillUI();
  driveTryAutoReconnect();
  document.addEventListener('click', (e) => {
    const wrap = document.querySelector('.drive-pill-wrap');
    if (wrap && !wrap.contains(e.target)) closeDriveMenu();
  });
}

function seedSampleBooks() {
  books = [
    { id: Date.now() + 1, title: 'Cien Años de Soledad', author: 'Gabriel García Márquez', lang: 'es', genre: 'Realismo Mágico', color: '#2E6F40', emoji: '🌺', status: 'reading', progress: 42, timesRead: 0,
      content: `Muchos años después, frente al pelotón de fusilamiento, el coronel Aureliano Buendía había de recordar aquella tarde remota en que su padre lo llevó a conocer el hielo.\n\nMacondo era entonces una aldea de veinte casas de barro y cañabrava construidas a la orilla de un río de aguas diáfanas que se precipitaban por un lecho de piedras pulidas, blancas y enormes como huevos prehistóricos. El mundo era tan reciente, que muchas cosas carecían de nombre, y para mencionarlas había que señalarlas con el dedo.\n\nTodos los años, por el mes de marzo, una familia de gitanos desarrapados plantaba su carpa cerca de la aldea, y con un grande alboroto de pitos y timbales daban a conocer los nuevos inventos. Primero llevaron el imán.\n\nJosé Arcadio Buendía, cuya desaforada imaginación iba siempre más lejos que el ingenio de la naturaleza, y aun más allá del milagro y la magia, pensó que era posible servirse de aquella invención inútil para desentrañar el oro de la tierra.`,
      addedAt: Date.now() - 86400000 * 10 },
    { id: Date.now() + 2, title: 'The Great Gatsby', author: 'F. Scott Fitzgerald', lang: 'en', genre: 'Classic', color: '#1B5E7A', emoji: '✨', status: 'finished', progress: 100, timesRead: 2,
      coverUrl: 'https://books.google.com/books/content?id=iXn5U2IziiEC&printsec=frontcover&img=1&zoom=1&source=gbs_api',
      content: `In my younger and more vulnerable years my father gave me some advice that I've been turning over in my mind ever since.\n\n"Whenever you feel like criticizing anyone," he told me, "just remember that all the people in this world haven't had the advantages that you've had."\n\nHe didn't say any more, but we've always been unusually communicative in a reserved way, and I understood that he meant a great deal more than that. In consequence, I'm inclined to reserve all judgments, a habit that has opened up many curious natures to me and also made me the victim of not a few veteran bores.`,
      addedAt: Date.now() - 86400000 * 5 },
    { id: Date.now() + 3, title: 'La Sombra del Viento', author: 'Carlos Ruiz Zafón', lang: 'es', genre: 'Misterio', color: '#4A3728', emoji: '🗡️', status: 'unread', progress: 0, timesRead: 0,
      content: `Todavía recuerdo aquel amanecer en que mi padre me llevó por primera vez a visitar el Cementerio de los Libros Olvidados.\n\nDesperté con los primeros resplandores del alba y no volví a dormirme. Mi padre, que era el librero más romántico del mundo, me había despertado a las cuatro de la mañana para llevarme a ese lugar secreto.\n\nNos deslizamos por las calles de una Barcelona atrapada bajo cielos de ceniza, mi padre y yo, como sombras perseguidas por el viento que se colaba entre los escombros de una ciudad que olía a lluvia y sal.`,
      addedAt: Date.now() - 86400000 * 2 },
    { id: Date.now() + 4, title: 'El Principito', author: 'Antoine de Saint-Exupéry', lang: 'es', genre: 'Fábula', color: '#B8860B', emoji: '🌟', status: 'finished', progress: 100, timesRead: 3,
      coverUrl: 'https://books.google.com/books/content?id=m2YOAAAAQBAJ&printsec=frontcover&img=1&zoom=1&source=gbs_api',
      content: `Cuando tenía seis años vi una vez una lámina magnífica en un libro sobre el Bosque Virgen que se llamaba "Historias vividas". Representaba una serpiente boa que se tragaba a una fiera.\n\nAquí está la copia del dibujo. En el libro se decía: "Las serpientes boas tragan su presa entera, sin masticarla. Luego ya no pueden moverse y duermen durante los seis meses que dura su digestión."\n\nReflexioné mucho en ese entonces sobre las aventuras de la jungla y logré trazar, con un lápiz de color, mi primer dibujo.`,
      addedAt: Date.now() - 86400000 * 20 }
  ];
  save();
}

function buildColorPicker() {
  const el = document.getElementById('color-picker');
  el.innerHTML = COLORS.map((c) => `<div class="color-swatch${selectedColor===c?' selected':''}" style="background:${c}" onclick="selectColor('${c}',this)" title="${c}"></div>`).join('');
}

function buildEmojiPicker() {
  const el = document.getElementById('emoji-picker');
  el.innerHTML = EMOJIS.map((e) => `<span style="cursor:pointer;font-size:22px;padding:4px 6px;border-radius:6px;border:2px solid ${selectedEmoji===e?'var(--accent)':'transparent'};transition:all 0.2s" onclick="selectEmoji('${e}',this)">${e}</span>`).join('');
}

function selectColor(c, el) {
  selectedColor = c;
  document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
  el.classList.add('selected');
}

function selectEmoji(e, el) {
  selectedEmoji = e;
  document.querySelectorAll('#emoji-picker span').forEach(s => s.style.borderColor = 'transparent');
  el.style.borderColor = 'var(--accent)';
  const coverUrl = document.getElementById('f-cover-url').value.trim();
  if (!coverUrl) updateCoverPreview('', e);
}

function save() {
  localStorage.setItem('biblioteca_books', JSON.stringify(books));
  updateCounts();
  scheduleDriveBackup();
}

function updateCounts() {
  document.getElementById('count-all').textContent = books.length;
  document.getElementById('count-es').textContent = books.filter(b => b.lang === 'es').length;
  document.getElementById('count-en').textContent = books.filter(b => b.lang === 'en').length;
  updateGenres();
  updateStats();
}

function updateGenres() {
  const genres = [...new Set(books.map(b => b.genre).filter(Boolean))];
  const el = document.getElementById('genres-list');
  el.innerHTML = genres.map(g => `<span class="genre-tag" onclick="setGenreFilter('${g}',this);closeSidebar()">${g}</span>`).join('');
}

function updateStats() {
  const total = books.length;
  const finished = books.filter(b => b.status === 'finished').length;
  const reading = books.filter(b => b.status === 'reading').length;
  const totalReads = books.reduce((s, b) => s + (b.timesRead || 0), 0);
  const avgPct = total > 0 ? Math.round(books.reduce((s, b) => s + (b.progress || 0), 0) / total) : 0;
  document.getElementById('stats-bar').innerHTML = `
    <div class="stat-card"><div class="stat-label">Total libros</div><div class="stat-value">${total}</div><div class="stat-sub">en tu biblioteca</div></div>
    <div class="stat-card"><div class="stat-label">Terminados</div><div class="stat-value">${finished}</div><div class="stat-sub">${reading} leyendo ahora</div></div>
    <div class="stat-card"><div class="stat-label">Lecturas</div><div class="stat-value">${totalReads}</div><div class="stat-sub">veces leídos total</div></div>
    <div class="stat-card"><div class="stat-label">Progreso</div><div class="stat-value">${avgPct}%</div><div class="stat-sub">promedio general</div></div>
  `;
}

function setFilter(f, el) {
  currentFilter = f;
  document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
  if (el) el.classList.add('active');
  const titles = { all: 'Mi Biblioteca', es: 'Libros en Español', en: 'Books in English', reading: 'Leyendo Ahora', finished: 'Libros Terminados' };
  document.getElementById('section-title').textContent = titles[f] || 'Mi Biblioteca';
  renderBooks();
}

function setGenreFilter(g, el) {
  currentFilter = 'genre:' + g;
  document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
  document.querySelectorAll('.genre-tag').forEach(t => t.classList.remove('active'));
  if (el) el.classList.add('active');
  document.getElementById('section-title').textContent = g;
  renderBooks();
}

function mobileFilter(f, btn) {
  document.querySelectorAll('.mobile-nav-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const map = { all: 'nav-all', reading: 'nav-reading', finished: 'nav-finished' };
  setFilter(f, document.getElementById(map[f]));
}

function filterBooks() { renderBooks(); }

function getFilteredBooks() {
  const q = document.getElementById('search-input').value.toLowerCase();
  let filtered = books;
  if (currentFilter === 'es') filtered = filtered.filter(b => b.lang === 'es');
  else if (currentFilter === 'en') filtered = filtered.filter(b => b.lang === 'en');
  else if (currentFilter === 'reading') filtered = filtered.filter(b => b.status === 'reading');
  else if (currentFilter === 'finished') filtered = filtered.filter(b => b.status === 'finished');
  else if (currentFilter.startsWith('genre:')) filtered = filtered.filter(b => b.genre === currentFilter.slice(6));
  if (q) filtered = filtered.filter(b => b.title.toLowerCase().includes(q) || (b.author||'').toLowerCase().includes(q) || (b.genre||'').toLowerCase().includes(q));
  return filtered;
}

function getLangFlag(lang) {
  const flags = { es: '🇪🇸', en: '🇺🇸', fr: '🇫🇷', pt: '🇧🇷', de: '🇩🇪' };
  return flags[lang] || '🌐';
}

function getStatusLabel(s) {
  if (s === 'reading') return '📖 Leyendo';
  if (s === 'finished') return '✅ Terminado';
  return '📋 Por leer';
}

function renderBooks() {
  const filtered = getFilteredBooks();
  const grid = document.getElementById('books-grid');
  if (filtered.length === 0) {
    grid.innerHTML = `<div class="empty-state" style="grid-column:1/-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg><h3>No hay libros aquí</h3><p style="font-size:13px;margin-top:8px;">Agrega tu primer libro con el botón de arriba</p></div>`;
    return;
  }
  grid.innerHTML = filtered.map(b => {
    const hasCover = b.coverUrl && b.coverUrl.trim();
    const isDrive = b.driveUrl && b.driveUrl.trim();
    const timesRead = b.timesRead || 0;
    const coverStyle = hasCover ? `background-image:url('${b.coverUrl}');background:${b.color};` : `background:${b.color};`;
    const coverClass = hasCover ? 'book-cover has-photo' : 'book-cover';
    const timesReadBadge = timesRead > 0 ? `<div class="book-times-badge">📖×${timesRead}</div>` : '';
    const driveBadge = isDrive ? `<div style="position:absolute;bottom:12px;right:8px;background:rgba(66,133,244,0.85);color:#fff;font-size:8px;padding:2px 5px;border-radius:4px;font-weight:600;letter-spacing:0.04em;">Drive</div>` : '';
    return `
    <div class="book-card" id="card-${b.id}">
      <div class="book-cover-wrap" onclick="openReader(${b.id})">
        <div class="${coverClass}" style="${coverStyle}">
          ${hasCover ? '<div class="book-cover-overlay"></div>' : ''}
          ${!hasCover ? '<div class="book-cover-spine"></div>' : ''}
          ${!hasCover ? `<div class="book-cover-icon">${b.emoji || '📖'}</div>` : ''}
          <div class="book-cover-title">${b.title}</div>
          <div class="book-cover-author">${b.author || ''}</div>
