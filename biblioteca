function importLibrary(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const data = JSON.parse(e.target.result);
      const imported = Array.isArray(data) ? data : (data.books || []);
      if (!Array.isArray(imported) || imported.length === 0) { showToast('❌ Archivo inválido o vacío'); return; }
      const validBooks = imported.filter(b => b && b.id && b.title && (b.content || b.driveUrl));
      if (validBooks.length === 0) { showToast('❌ No se encontraron libros válidos'); return; }
      const action = confirm(`Se encontraron ${validBooks.length} libro(s).\n\n¿Deseas REEMPLAZAR tu biblioteca actual, o AGREGAR los nuevos libros?\n\nAceptar = Reemplazar\nCancelar = Agregar`);
      if (action) {
        books = validBooks;
        showToast(`📥 Biblioteca importada: ${validBooks.length} libros`);
      } else {
        const existingIds = new Set(books.map(b => b.id));
        const newBooks = validBooks.filter(b => !existingIds.has(b.id));
        books = [...newBooks, ...books];
        showToast(`📥 Agregados ${newBooks.length} libro(s) nuevos`);
      }
      save(); renderAll();
    } catch (err) { showToast('❌ Error al leer el archivo JSON'); }
    event.target.value = '';
  };
  reader.readAsText(file);
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

/* ══════════════════════════════════════════════════════
   GOOGLE DRIVE BACKUP MODULE
   Backup, not sync: localStorage (biblioteca_books) is always
   the source of truth. Drive only ever gets pushed TO, and is
   only ever pulled FROM on an explicit, confirmed user action.
   ══════════════════════════════════════════════════════ */

const DRIVE_CONFIG = {
  // Replace with your OAuth Client ID from Google Cloud Console (see README setup section).
  CLIENT_ID: 'YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com',
  SCOPE: 'https://www.googleapis.com/auth/drive.file',
  FILENAME: 'biblioteca_backup.json',
  RECONNECT_FLAG: 'biblioteca_drive_connected',
  DEBOUNCE_MS: 2500,
};

const driveState = {
  tokenClient: null,
  accessToken: null,
  tokenExpiresAt: 0,
  fileId: null,
  connected: false,
  connecting: false,
  lastBackupAt: null,
  pushInFlight: false,
  pushQueued: false,
  debounceTimer: null,
  errorMsg: null,
};

function driveConfigured() {
  return DRIVE_CONFIG.CLIENT_ID && !DRIVE_CONFIG.CLIENT_ID.startsWith('YOUR_GOOGLE_CLIENT_ID');
}

function driveGetTokenClient() {
  if (!driveState.tokenClient) {
    driveState.tokenClient = google.accounts.oauth2.initTokenClient({
      client_id: DRIVE_CONFIG.CLIENT_ID,
      scope: DRIVE_CONFIG.SCOPE,
      callback: () => {}, // overridden per-call in driveRequestToken
    });
  }
  return driveState.tokenClient;
}

function driveRequestToken(silent) {
  return new Promise((resolve, reject) => {
    if (!driveConfigured()) {
      reject(new Error('Google Drive no está configurado todavía (falta el Client ID). Revisa el README.'));
      return;
    }
    if (typeof google === 'undefined' || !google.accounts || !google.accounts.oauth2) {
      reject(new Error('No se pudo cargar Google Identity Services (revisa tu conexión a internet).'));
      return;
    }
    try {
      const client = driveGetTokenClient();
      client.callback = (resp) => {
        if (resp && resp.error) {
          reject(new Error('No se pudo obtener acceso a Google Drive: ' + resp.error));
          return;
        }
        if (!resp || !resp.access_token) {
          reject(new Error('Google no devolvió un token de acceso válido.'));
          return;
        }
        driveState.accessToken = resp.access_token;
        driveState.tokenExpiresAt = Date.now() + (Number(resp.expires_in || 3600) * 1000);
        resolve(resp.access_token);
      };
      client.error_callback = (err) => {
        reject(new Error(err && err.message ? err.message : 'La ventana de Google se cerró o falló.'));
      };
      client.requestAccessToken({
        prompt: silent ? '' : 'select_account consent',
      });
    } catch (err) {
      reject(new Error('Error al iniciar la conexión con Google: ' + err.message));
    }
  });
}

async function driveGetValidToken() {
  const hasTime = driveState.accessToken && (driveState.tokenExpiresAt - Date.now() > 60000);
  if (hasTime) return driveState.accessToken;
  return driveRequestToken(true);
}

async function driveApiFetch(url, options = {}) {
  const token = await driveGetValidToken();
  const headers = Object.assign({}, options.headers, { Authorization: `Bearer ${token}` });
  const res = await fetch(url, Object.assign({}, options, { headers }));
  if (!res.ok) {
    let detail = '';
    try { const j = await res.json(); detail = j.error?.message || ''; } catch (e) {}
    throw new Error(`Drive API error (${res.status}): ${detail || res.statusText}`);
  }
  return res;
}

async function driveFindFile() {
  const q = encodeURIComponent(`name = '${DRIVE_CONFIG.FILENAME}' and trashed = false`);
  const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files?q=${q}&fields=files(id,name,modifiedTime)&spaces=drive`);
  const data = await res.json();
  return (data.files && data.files.length > 0) ? data.files[0] : null;
}

async function driveCreateFile(payload) {
  const boundary = 'biblioteca_boundary_' + Date.now();
  const metadata = { name: DRIVE_CONFIG.FILENAME, mimeType: 'application/json' };
  const body =
    `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify(metadata)}\r\n` +
    `--${boundary}\r\nContent-Type: application/json\r\n\r\n${JSON.stringify(payload)}\r\n` +
    `--${boundary}--`;
  const res = await driveApiFetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id', {
    method: 'POST',
    headers: { 'Content-Type': `multipart/related; boundary=${boundary}` },
    body,
  });
  const data = await res.json();
  return data.id;
}

async function driveUpdateFile(fileId, payload) {
  await driveApiFetch(`https://www.googleapis.com/upload/drive/v3/files/${fileId}?uploadType=media`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload),
  });
}

async function driveDownloadFile(fileId) {
  const res = await driveApiFetch(`https://www.googleapis.com/drive/v3/files/${fileId}?alt=media`);
  return res.json();
}

function buildBackupPayload() {
  return { version: '1.0', exportedAt: new Date().toISOString(), books };
}

async function pushToDrive() {
  if (driveState.pushInFlight) { driveState.pushQueued = true; return; }
  driveState.pushInFlight = true;
  try {
    const payload = buildBackupPayload();
    if (!driveState.fileId) {
      const existing = await driveFindFile();
      driveState.fileId = existing ? existing.id : await driveCreateFile(payload);
      if (existing) await driveUpdateFile(driveState.fileId, payload);
    } else {
      await driveUpdateFile(driveState.fileId, payload);
    }
    driveState.lastBackupAt = Date.now();
    driveState.errorMsg = null;
    updateDrivePillUI();
  } catch (err) {
    driveState.errorMsg = err.message;
    updateDrivePillUI();
    showToast('⚠️ Error al respaldar en Drive: ' + err.message);
  } finally {
    driveState.pushInFlight = false;
    if (driveState.pushQueued) {
      driveState.pushQueued = false;
      pushToDrive();
    }
  }
}

function scheduleDriveBackup() {
  if (!driveState.connected) return;
  clearTimeout(driveState.debounceTimer);
  driveState.debounceTimer = setTimeout(() => { pushToDrive(); }, DRIVE_CONFIG.DEBOUNCE_MS);
}

async function driveBackupNow() {
  if (!driveState.connected) return;
  clearTimeout(driveState.debounceTimer);
  updateDrivePillUI('connecting');
  await pushToDrive();
  if (!driveState.errorMsg) showToast('☁️ Biblioteca respaldada en Google Drive');
  updateDrivePillUI();
}

async function driveConnect() {
  if (!driveConfigured()) {
    showToast('⚠️ Google Drive aún no está configurado — revisa el README para agregar tu Client ID.');
    return;
  }
  dismissReconnectBanner();
  driveState.connecting = true;
  updateDrivePillUI('connecting');
  try {
    await driveRequestToken(false);
    const existing = await driveFindFile();
    if (existing) {
      driveState.fileId = existing.id;
      const wantsRestore = confirm(
        'Ya existe un respaldo de tu biblioteca en Google Drive.\n\n' +
        '¿Deseas RESTAURARLO ahora (reemplaza los libros de este dispositivo), ' +
        'o mantener los libros de este dispositivo y sobrescribir el respaldo de Drive?\n\n' +
        'Aceptar = Restaurar desde Drive\nCancelar = Mantener este dispositivo y sobrescribir Drive'
      );
      if (wantsRestore) {
        const payload = await driveDownloadFile(driveState.fileId);
        applyRestoredBooks(payload);
        showToast('📥 Biblioteca restaurada desde Google Drive');
      } else {
        await pushToDrive();
        showToast('☁️ Google Drive conectado — se sobrescribió el respaldo existente');
      }
    } else {
      driveState.fileId = await driveCreateFile(buildBackupPayload());
      driveState.lastBackupAt = Date.now();
      showToast('☁️ Google Drive conectado — primer respaldo creado');
    }
    driveState.connected = true;
    localStorage.setItem(DRIVE_CONFIG.RECONNECT_FLAG, '1');
  } catch (err) {
    driveState.errorMsg = err.message;
    showToast('❌ No se pudo conectar con Google Drive: ' + err.message);
  } finally {
    driveState.connecting = false;
    updateDrivePillUI();
  }
}

function driveDisconnect() {
  try {
    if (driveState.accessToken && google.accounts && google.accounts.oauth2) {
      google.accounts.oauth2.revoke(driveState.accessToken, () => {});
    }
  } catch (e) {}
  driveState.accessToken = null;
  driveState.tokenExpiresAt = 0;
  driveState.fileId = null;
  driveState.connected = false;
  driveState.lastBackupAt = null;
  driveState.errorMsg = null;
  localStorage.removeItem(DRIVE_CONFIG.RECONNECT_FLAG);
  updateDrivePillUI();
  showToast('🔌 Google Drive desconectado — tus libros permanecen solo en este dispositivo');
}

async function driveRestore() {
  if (!driveState.connected) return;
  const ok = confirm('Esto reemplazará TODOS los libros de este dispositivo con la copia guardada en Google Drive. ¿Continuar?');
  if (!ok) return;
  try {
    updateDrivePillUI('connecting');
    if (!driveState.fileId) {
      const existing = await driveFindFile();
      if (!existing) { showToast('⚠️ No se encontró ningún respaldo en Drive todavía'); updateDrivePillUI(); return; }
      driveState.fileId = existing.id;
    }
    const payload = await driveDownloadFile(driveState.fileId);
    applyRestoredBooks(payload);
    showToast('📥 Biblioteca restaurada desde Google Drive');
  } catch (err) {
    showToast('❌ Error al restaurar desde Drive: ' + err.message);
  } finally {
    updateDrivePillUI();
  }
}

function applyRestoredBooks(payload) {
  // Handle both the current shape ({version, exportedAt, books}) and a bare array (legacy/manual exports).
  const incoming = Array.isArray(payload) ? payload : (payload && Array.isArray(payload.books) ? payload.books : null);
  if (!incoming) { showToast('❌ El respaldo de Drive no tiene un formato reconocible'); return; }
  const validBooks = incoming.filter(b => b && b.id && b.title && (b.content || b.driveUrl || b.content === ''));
  if (validBooks.length === 0) { showToast('❌ El respaldo de Drive está vacío o es inválido'); return; }
  books = validBooks;
  localStorage.setItem('biblioteca_books', JSON.stringify(books));
  renderAll();
}

async function driveTryAutoReconnect() {
  if (localStorage.getItem(DRIVE_CONFIG.RECONNECT_FLAG) !== '1') return;
  if (!driveConfigured()) return;
  updateDrivePillUI('connecting');
  try {
    await driveRequestToken(true);
    const existing = await driveFindFile();
    if (existing) driveState.fileId = existing.id;
    driveState.connected = true;
    driveState.errorMsg = null;
    updateDrivePillUI();
  } catch (err) {
    driveState.connected = false;
    showReconnectBanner();
    updateDrivePillUI('error');
  }
}

/* ── DRIVE UI ── */
function driveRelativeTime(ts) {
  if (!ts) return '';
  const diff = Math.max(0, Date.now() - ts);
  const mins = Math.round(diff / 60000);
  if (mins < 1) return 'justo ahora';
  if (mins < 60) return `hace ${mins} min`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `hace ${hrs} h`;
  return `hace ${Math.round(hrs / 24)} d`;
}

function updateDrivePillUI(forceState) {
  const pill = document.getElementById('drive-pill');
  const label = document.getElementById('drive-pill-label');
  const status = document.getElementById('drive-menu-status');
  const btnConnect = document.getElementById('drive-menu-connect');
  const btnBackup = document.getElementById('drive-menu-backup');
  const btnRestore = document.getElementById('drive-menu-restore');
  const btnDisconnect = document.getElementById('drive-menu-disconnect');
  let state = forceState || (driveState.errorMsg ? 'error' : (driveState.connected ? 'connected' : (driveState.connecting ? 'connecting' : 'off')));
  pill.dataset.state = state;
  if (state === 'connected') {
    label.textContent = driveState.lastBackupAt ? driveRelativeTime(driveState.lastBackupAt) : 'Conectado';
    status.textContent = driveState.lastBackupAt ? `Último respaldo: ${driveRelativeTime(driveState.lastBackupAt)}` : 'Conectado — esperando el primer respaldo.';
  } else if (state === 'connecting') {
    label.textContent = 'Conectando…';
    status.textContent = 'Conectando con Google Drive…';
  } else if (state === 'error') {
    label.textContent = 'Error';
    status.textContent = driveState.errorMsg || 'Ocurrió un error con Google Drive.';
  } else {
    label.textContent = 'Drive';
    status.textContent = 'Sin conectar — tus libros solo viven en este dispositivo.';
  }
  btnConnect.style.display = driveState.connected ? 'none' : 'flex';
  btnBackup.style.display = driveState.connected ? 'flex' : 'none';
  btnRestore.style.display = driveState.connected ? 'flex' : 'none';
  btnDisconnect.style.display = driveState.connected ? 'flex' : 'none';
}

function toggleDriveMenu() {
  document.getElementById('drive-menu').classList.toggle('open');
}
function closeDriveMenu() {
  document.getElementById('drive-menu').classList.remove('open');
}
function onDrivePillClick() {
  if (!driveState.connected) {
    toggleDriveMenu();
  } else {
    toggleDriveMenu();
  }
}
function driveMenuAction(action) {
  closeDriveMenu();
  if (action === 'connect') driveConnect();
  else if (action === 'backup') driveBackupNow();
  else if (action === 'restore') driveRestore();
  else if (action === 'disconnect') driveDisconnect();
}
function showReconnectBanner() {
  document.getElementById('app').classList.add('has-reconnect-banner');
  document.getElementById('drive-reconnect-banner').classList.add('show');
}
function dismissReconnectBanner() {
  document.getElementById('app').classList.remove('has-reconnect-banner');
  document.getElementById('drive-reconnect-banner').classList.remove('show');
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (document.getElementById('modal-overlay').classList.contains('open')) closeModal();
    else if (document.getElementById('reader-view').classList.contains('open')) closeReader();
    else closeSidebar();
  }
});

init();
</script>
