/* Convert Google Drive share URL to embed/preview URL */
function driveUrlToEmbed(url) {
  if (!url) return null;
  // Google Docs
  if (url.includes('docs.google.com/document')) {
    const m = url.match(/\/d\/([^/]+)/);
    if (m) return `https://docs.google.com/document/d/${m[1]}/preview`;
  }
  // Google Drive file
  const m = url.match(/\/file\/d\/([^/]+)/);
  if (m) return `https://drive.google.com/file/d/${m[1]}/preview`;
  // drive.google.com/open?id=
  const m2 = url.match(/[?&]id=([^&]+)/);
  if (m2) return `https://drive.google.com/file/d/${m2[1]}/preview`;
  return url; // fallback
}

function saveBook() {
  const title = document.getElementById('f-title').value.trim();
  const content = document.getElementById('f-content').value.trim();
  const driveUrl = document.getElementById('f-drive-url').value.trim();
  const coverUrl = document.getElementById('f-cover-url').value.trim();

  if (!title) { showToast('Por favor ingresa un título'); return; }
  if (activeContentTab === 'text' && !content) { showToast('Por favor agrega el contenido del libro'); return; }
  if (activeContentTab === 'drive' && !driveUrl) { showToast('Por favor ingresa el enlace de Google Drive'); return; }

  const bookData = {
    title,
    author: document.getElementById('f-author').value.trim(),
    lang: document.getElementById('f-lang').value,
    genre: document.getElementById('f-genre').value.trim(),
    content: activeContentTab === 'text' ? content : '',
    driveUrl: activeContentTab === 'drive' ? driveUrl : '',
    coverUrl,
    status: document.getElementById('f-status').value,
    color: selectedColor,
    emoji: selectedEmoji
  };

  if (editingId) {
    const idx = books.findIndex(b => b.id === editingId);
    if (idx > -1) {
      books[idx] = { ...books[idx], ...bookData };
      if (books[idx].status === 'finished') books[idx].progress = 100;
    }
    showToast('✅ Libro actualizado');
  } else {
    books.unshift({ id: Date.now(), ...bookData, progress: 0, timesRead: 0, addedAt: Date.now() });
    showToast('📚 Libro agregado a tu biblioteca');
  }
  save(); renderAll(); closeModal();
}

function deleteBook(id) {
  if (!confirm('¿Eliminar este libro de tu biblioteca?')) return;
  books = books.filter(b => b.id !== id);
  save(); renderAll();
